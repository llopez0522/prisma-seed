{
  "name": "prisma-seed",
  "version": "1.0.0",
  "description": "A CLI tool to generate and manage Prisma seed files, with Laravel-style commands.",
  "type": "module",
  "bin": {
    "prisma-seed": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{src,tests}/**/*.{ts,mts}\" \"*.{ts,js,json}\" \".github/**/*.yml\" \"docker-compose.yml\"",
    "format:check": "prettier --check \"{src,tests}/**/*.{ts,mts}\" \"*.{ts,js,json}\" \".github/**/*.yml\" \"docker-compose.yml\"",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "check": "npm run typecheck && npm run lint && npm run test",
    "prepack": "npm run build"
  },
  "keywords": [
    "prisma",
    "seeds",
    "seeder",
    "generator",
    "cli",
    "database",
    "migration"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/llopez0522/prisma-seed.git"
  },
  "homepage": "https://github.com/llopez0522/prisma-seed#readme",
  "bugs": {
    "url": "https://github.com/llopez0522/prisma-seed/issues"
  },
  "author": "Luis Lopez <luism.lopezl22@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.6.0",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1"
  },
  "peerDependencies": {
    "@prisma/client": ">=5 <7"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": false
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@prisma/client": "^6.1.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.0",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
